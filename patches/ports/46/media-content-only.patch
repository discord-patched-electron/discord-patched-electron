+From: DPE maintainers
+Subject: Exclude Discord application sounds from desktop media sessions
+
+diff --git a/third_party/blink/renderer/platform/media/dpe_media_session_policy.h b/third_party/blink/renderer/platform/media/dpe_media_session_policy.h
+new file mode 100644
+--- /dev/null
++++ b/third_party/blink/renderer/platform/media/dpe_media_session_policy.h
+@@ -0,0 +1,24 @@
++// Discord UI sounds are static application assets. Uploaded media and embeds
++// retain Chromium's normal media sessions, regardless of their duration.
++#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_MEDIA_DPE_MEDIA_SESSION_POLICY_H_
++#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_MEDIA_DPE_MEDIA_SESSION_POLICY_H_
++
++#include <string_view>
++
++namespace blink {
++constexpr bool DpeIsApplicationSound(std::string_view scheme,
++                                     std::string_view host,
++                                     std::string_view path,
++                                     bool has_video) {
++  if (has_video || scheme != "https")
++    return false;
++  const bool discord_host =
++      host == "discord.com" || host == "canary.discord.com" ||
++      host == "ptb.discord.com" || host == "cdn.discordapp.com" ||
++      host == "cdn.discordapp.net" || host == "static.discord.com";
++  return discord_host && (path.starts_with("/assets/") ||
++                          path.starts_with("/sounds/"));
++}
++}  // namespace blink
++
++#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_MEDIA_DPE_MEDIA_SESSION_POLICY_H_
