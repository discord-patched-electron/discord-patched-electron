+#if BUILDFLAG(IS_LINUX)
+void NativeWindowViews::SetWindowControls(const WindowControls& controls) {
+  if (window_controls_ == controls)
+    return;
+
+  window_controls_ = controls;
+  UpdateWindowControls();
+}
+
+void NativeWindowViews::OnWidgetShowStateChanged(views::Widget* widget) {
+  if (pending_window_controls_ && !IsMinimized())
+    UpdateWindowControls();
+}
+
+void NativeWindowViews::UpdateWindowControls() {
+  // Restored bounds still belong to the old frame while the WM has the window
+  // minimized. Apply after its native restore acknowledgement, when the client
+  // geometry is current; never resize/redecorate an unmapped restore target.
+  if (IsMinimized()) {
+    pending_window_controls_ = true;
+    return;
+  }
+  pending_window_controls_ = false;
+  widget()->LayoutRootViewIfNecessary();
+  const bool had_client_frame = has_client_frame();
+  const gfx::Rect content_bounds = GetContentBounds();
+  use_client_frame_for_controls_ = has_frame() && !window_controls_.AllVisible();
+  if (has_frame() && had_client_frame != has_client_frame()) {
+    // Reuse Chromium's native GTK frame, not a renderer titlebar. Changing only
+    // decorations keeps minimize/maximize/close shortcuts and capabilities.
+    widget()->set_frame_type(has_client_frame()
+                                 ? views::Widget::FrameType::kForceCustom
+                                 : views::Widget::FrameType::kForceNative);
+    widget()->FrameTypeChanged();
+  }
+  auto* tree_host = static_cast<ElectronDesktopWindowTreeHostLinux*>(
+      views::DesktopWindowTreeHostLinux::GetHostForWidget(GetAcceleratedWidget()));
+  if (auto* frame = GetFrameViewLinux()) {
+    if (tree_host)
+      frame->SetSupportsClientFrameShadow(tree_host->SupportsClientFrameShadow() &&
+                                         !IsTranslucent());
+    frame->InvalidateLayout();
+    frame->SchedulePaint();
+  }
+  if (has_frame() && had_client_frame != has_client_frame() &&
+      !IsMaximized() && !IsMinimized() && !IsFullscreen())
+    SetBounds(ContentBoundsToWindowBounds(content_bounds), false);
+  widget()->LayoutRootViewIfNecessary();
+  if (tree_host)
+    tree_host->UpdateFrameHints();
+}
+
+bool NativeWindowViews::IsFrameButtonVisible(views::FrameButton button) const {
+  switch (button) {
+    case views::FrameButton::kMinimize:
+      return window_controls_.minimize;
+    case views::FrameButton::kMaximize:
+      return window_controls_.maximize;
+    case views::FrameButton::kClose:
+      return window_controls_.close;
+  }
+}
+#endif
