++
++#ifndef THIRD_PARTY_BLINK_RENDERER_CORE_EDITING_SPELLCHECK_DPE_EDIT_GESTURE_H_
++#define THIRD_PARTY_BLINK_RENDERER_CORE_EDITING_SPELLCHECK_DPE_EDIT_GESTURE_H_
++
++#include "third_party/blink/renderer/core/frame/local_dom_window.h"
++#include "third_party/blink/renderer/core/frame/local_frame.h"
++#include "third_party/blink/renderer/platform/weborigin/security_origin.h"
++
++namespace blink {
++
++// Discord mounts and focuses its prefilled Slate editor from the user's Edit
++// action. Treat that short-lived gesture as an editing request, without lifting
++// Chromium's script-focus restrictions in other sites or embedded frames.
++inline bool HasDiscordEditGesture(const LocalDOMWindow& window) {
++  const LocalFrame* frame = window.GetFrame();
++  const SecurityOrigin* origin = window.GetSecurityOrigin();
++  if (!frame || !frame->IsMainFrame() || origin->Protocol() != "https" ||
++      !LocalFrame::HasTransientUserActivation(frame)) {
++    return false;
++  }
++  const String& host = origin->Host();
++  return host == "discord.com" || host == "canary.discord.com" ||
++         host == "ptb.discord.com";
++}
++
++}  // namespace blink
++
++#endif  // THIRD_PARTY_BLINK_RENDERER_CORE_EDITING_SPELLCHECK_DPE_EDIT_GESTURE_H_
