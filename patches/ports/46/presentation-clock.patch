diff --git a/discord/discord_video_source.cc b/discord/discord_video_source.cc
--- a/discord/discord_video_source.cc
+++ b/discord/discord_video_source.cc
@@ -234,7 +234,18 @@
     if (ELECTRON_VIDEO_SUCCEEDED(frame.frame.electron->QueryInterface(
             discord::media::electron::IElectronVideoFrameMedia::IID,
             electron_frame_media.Receive<void>()))) {
-      video_frame = electron_frame_media->GetMediaFrame();
+      // The decoder retains its original RTP-tagged frame. Wrap its storage
+      // before applying the direct sink's microsecond presentation timestamp;
+      // no pixels or GPU textures are copied and other decoder owners are safe.
+      auto* decoded_frame = electron_frame_media->GetMediaFrame();
+      if (decoded_frame) {
+        video_frame = media::VideoFrame::WrapVideoFrame(
+            decoded_frame, decoded_frame->format(), decoded_frame->visible_rect(),
+            decoded_frame->natural_size());
+        if (video_frame) {
+          video_frame->set_timestamp(base::Microseconds(frame.timestamp_us));
+        }
+      }
     }
   }
 
@@ -268,10 +279,23 @@
   }
   video_frame->metadata().transformation = media::VideoTransformation(rotation);
 
+  // Match Chromium's remote WebRTC source: the native timestamp is the
+  // planned presentation time on the monotonic clock. Without reference_time
+  // the MediaStream compositor disables its render-smoothness algorithm and
+  // overwrites frames arriving between display ticks. Zero remains immediate
+  // for previews; this adds no fixed playout delay or pixel copy.
+  base::TimeTicks render_time = base::TimeTicks::Now();
+  if (frame.timestamp_us > 0) {
+    render_time = base::TimeTicks() + base::Microseconds(frame.timestamp_us);
+    video_frame->metadata().reference_time = render_time;
+  } else {
+    video_frame->metadata().reference_time.reset();
+  }
+
   PostCrossThreadTask(
       *video_task_runner_.get(), FROM_HERE,
       CrossThreadBindOnce(&VideoSourceDelegate::DoRenderFrameOnIOThread,
                           WrapRefCounted(this), video_frame,
-                          base::TimeTicks()));
+                          render_time));
 
