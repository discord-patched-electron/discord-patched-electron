+    case LocaleResourceStatus::kLoaded:
+      dict.Set("status", "loaded");
+      break;
+    case LocaleResourceStatus::kFallback:
+      dict.Set("status", "fallback");
+      break;
+    case LocaleResourceStatus::kUnavailable:
