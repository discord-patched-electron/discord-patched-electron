+bool capture_frame_due()
+{
+    unsigned fps = atomic_load_explicit(&frame_fps, memory_order_relaxed);
+    if (!fps)
+        return true;
+    /* A competing present must never wait for the pacing state. */
+    if (atomic_flag_test_and_set_explicit(&frame_busy, memory_order_acquire))
+        return false;
+    if (atomic_exchange_explicit(&frame_reset, false, memory_order_relaxed) ||
+        frame_rate.interval != 1000000000ull / fps)
+        dpe_capture_rate_configure(&frame_rate, fps);
+    bool due = dpe_capture_rate_due(&frame_rate, (uint64_t)os_time_get_nano());
+    atomic_flag_clear_explicit(&frame_busy, memory_order_release);
+    return due;
+}
