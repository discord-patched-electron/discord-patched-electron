+  ElectronVideoStatus Initialize();
+  ElectronVideoStatus SubmitBuffer(IElectronBuffer* buffer, uint32_t timestamp);
+  void GetErrorInfo(ElectronVideoDecodeErrorCB* errorCB, void* userData);
+  void DeleteSoon();
