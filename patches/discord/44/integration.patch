+ static int mf_wait_events(AVCodecContext *avctx)
+ {
+     MFContext *c = avctx->priv_data;
+@@ -1319,27 +1315,6 @@ static int mf_init_encoder(AVCodecContext *avctx)
+     return 0;
+ }
+ 
+-#if !HAVE_UWP
