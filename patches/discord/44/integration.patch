diff --git a/patches/chromium/fix_pointer_lock_in_views_that_only_receive_forwarded_input.patch b/patches/chromium/fix_pointer_lock_in_views_that_only_receive_forwarded_input.patch
new file mode 100644
index 000000000..d0d95ca11
--- /dev/null
+++ b/patches/chromium/fix_pointer_lock_in_views_that_only_receive_forwarded_input.patch
@@ -0,0 +1,58 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Cap <cap-bot@discord.com>
+Date: Thu, 15 Oct 2026 12:00:00 -0700
+Subject: fix: pointer lock in views that only receive forwarded input
+
+A view painted beneath another view, such as a WebContentsView whose mouse
+input is relayed to it by the view above over CDP, never receives real OS
+mouse events. Pointer lock depends on them in two ways, and both broke.
+
+Unlock restores the cursor to the position the view last saw in a real
+mouse event, which such a view never records, so every unlock warped the
+cursor to the view's top-left corner. Record the real OS cursor position
+each time a lock begins instead, so unlock returns the cursor to where that
+lock started. For views that do receive real mouse events this matches the
+last event position, as a lock is requested in response to one, and it
+brings Aura in line with macOS, which already restores the cursor to the OS
+position read at lock time.
+
+While locked, the view keeps the hidden cursor centered and turns real
+mouse input into relative movement, but only for events it receives, and
+locking does not take mouse capture, so events kept going to the window
+under the cursor. The cursor was never recentered, ran into the lock's
+clip region or the screen edge, and movement stopped. Take mouse capture
+when the lock begins, as this code did before the lock moved into
+WindowTreeHost::LockMouse. Unlocking already releases capture held by the
+locked window, and views that lock on a mouse press already hold capture
+from that press.
+
+diff --git a/content/browser/renderer_host/render_widget_host_view_event_handler.cc b/content/browser/renderer_host/render_widget_host_view_event_handler.cc
+index 0de09e162bb4b16f84a90a29c5b70505f343ee1d..c4488847b78f629d74568daae17687b2e4b2d0d8 100644
+--- a/content/browser/renderer_host/render_widget_host_view_event_handler.cc
++++ b/content/browser/renderer_host/render_widget_host_view_event_handler.cc
+@@ -32,6 +32,7 @@
+ #include "ui/base/ime/text_input_client.h"
+ #include "ui/compositor/compositor.h"
+ #include "ui/compositor/layer.h"
++#include "ui/display/screen.h"
+ #include "ui/events/blink/blink_event_util.h"
+ #include "ui/events/blink/web_input_event.h"
+ #include "ui/events/keycodes/dom/dom_code.h"
+@@ -146,10 +147,17 @@ blink::mojom::PointerLockResult RenderWidgetHostViewEventHandler::LockPointer(
+     if (!mouse_locked_unadjusted_movement_)
+       return blink::mojom::PointerLockResult::kUnsupportedOptions;
+   }
++
++  unlocked_global_mouse_position_ =
++      gfx::PointF(display::Screen::Get()->GetCursorScreenPoint());
++  unlocked_mouse_position_ = unlocked_global_mouse_position_ -
++                             window_->GetBoundsInScreen().OffsetFromOrigin();
++
+   mouse_locked_ = true;
+ 
+   aura::Window::ScopedDeleteBlocker delete_blocker(window_);
+   window_->GetHost()->LockMouse(window_);
++  window_->SetCapture();
+ 
+   if (ShouldMoveToCenter(unlocked_global_mouse_position_))
+     MoveCursorToCenter(nullptr);
diff --git a/patches/chromium/fix_preload_oleaut32_dll_before_sandbox_lockdown.patch b/patches/chromium/fix_preload_oleaut32_dll_before_sandbox_lockdown.patch
new file mode 100644
index 000000000..909709870
--- /dev/null
+++ b/patches/chromium/fix_preload_oleaut32_dll_before_sandbox_lockdown.patch
@@ -0,0 +1,86 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: dyc <dennischengo@gmail.com>
+Date: Thu, 9 Jul 2026 20:53:45 +0000
+Subject: fix: preload oleaut32.dll before sandbox lockdown
+
+The sandboxed proxy-resolver process exits through the normal CRT shutdown
+path, and a CRT atexit callback there makes the first call into
+delay-loaded oleaut32.dll. Post-lockdown, LoadLibrary fails with
+ERROR_ACCESS_DENIED and Chromium's delay-load failure hook crashes the
+process (crbug.com/1320845).
+
+Add a warmup alongside WarmupRandomnessInfrastructure() in
+sandbox_warmup.cc, called from utility_main.cc for the proxy resolver
+process before LowerToken().
+
+diff --git a/content/utility/BUILD.gn b/content/utility/BUILD.gn
+index ff11e0d050535122e87809b468bc5415afabd1ce..7e3caa74256a65d912dd35762e68cbf9aeed6953 100644
+--- a/content/utility/BUILD.gn
++++ b/content/utility/BUILD.gn
+@@ -66,6 +66,7 @@ source_set("utility") {
+     "//services/on_device_model:on_device_model_service",
+     "//services/on_device_model/public/cpp",
+     "//services/on_device_model/public/mojom",
++    "//services/proxy_resolver/public/mojom",
+     "//services/screen_ai/buildflags",
+     "//services/service_manager/public/cpp",
+     "//services/service_manager/public/mojom",
+diff --git a/content/utility/utility_main.cc b/content/utility/utility_main.cc
+index 3eb18f885a6d2051d517def6d06a09f02c00069f..3f1ff1f805dccfd23cc1c664adba80c66c0933a1 100644
+--- a/content/utility/utility_main.cc
++++ b/content/utility/utility_main.cc
+@@ -41,6 +41,7 @@
+ #include "sandbox/policy/sandbox.h"
+ #include "sandbox/policy/sandbox_type.h"
+ #include "services/on_device_model/public/mojom/on_device_model_service.mojom.h"
++#include "services/proxy_resolver/public/mojom/proxy_resolver.mojom.h"
+ #include "services/tracing/public/cpp/trace_startup.h"
+ #include "services/video_capture/public/mojom/video_capture_service.mojom.h"
+ 
+@@ -482,6 +483,10 @@ int UtilityMain(MainFunctionParams parameters) {
+ 
+     sandbox::policy::WarmupRandomnessInfrastructure();
+ 
++    if (utility_sub_type == proxy_resolver::mojom::ProxyResolverFactory::Name_) {
++      sandbox::policy::WarmupOleAut32();
++    }
++
+     g_utility_target_services->LowerToken();
+   }
+ #endif
+diff --git a/sandbox/policy/win/sandbox_warmup.cc b/sandbox/policy/win/sandbox_warmup.cc
+index 4cfcf6e6a9e8d092608ba017b3eb04af1a14dffd..127a8ec7b765b9968aaedb82116779a6db7f3d46 100644
+--- a/sandbox/policy/win/sandbox_warmup.cc
++++ b/sandbox/policy/win/sandbox_warmup.cc
+@@ -29,6 +29,10 @@ void WarmupRandomnessInfrastructure() {
+   sandbox::WarmupRandomnessInfrastructure();
+ }
+ 
++void WarmupOleAut32() {
++  ::LoadLibraryW(L"oleaut32.dll");
++}
++
+ bool HookDwriteGetUserDefaultLCID() {
+   // Should not be called twice.
+   static bool first_call = true;
+diff --git a/sandbox/policy/win/sandbox_warmup.h b/sandbox/policy/win/sandbox_warmup.h
+index d3f18e6d96e589b8f6baf9798a3bc71051bf029b..a53db1f5d5df05419e2813e585b8bb7978510dd3 100644
+--- a/sandbox/policy/win/sandbox_warmup.h
++++ b/sandbox/policy/win/sandbox_warmup.h
+@@ -19,6 +19,16 @@ SANDBOX_POLICY_EXPORT void WarmupRandomnessInfrastructure();
+ // or the hooks could not be emplaced. If emplaced, the hooks are never removed.
+ SANDBOX_POLICY_EXPORT bool HookDwriteGetUserDefaultLCID();
+ 
++// Call in the sandboxed proxy resolver process before target lockdown.
++// oleaut32.dll is delay-loaded (see https://crbug.com/439521000), and the
++// proxy resolver's CRT atexit teardown makes its first call into a
++// delay-loaded oleaut32 export during clean shutdown. A post-lockdown
++// LoadLibrary for that first call fails with ERROR_ACCESS_DENIED, and
++// Chromium's delay-load failure hook then crashes the process (see
++// https://crbug.com/1320845). Loading the DLL here means later delay-loads
++// resolve from the loader's module table without touching the filesystem.
++SANDBOX_POLICY_EXPORT void WarmupOleAut32();
++
+ }  // namespace sandbox::policy
+ 
+ #endif  // SANDBOX_POLICY_WIN_SANDBOX_WARMUP_H_
diff --git a/patches/chromium/fix_recover_from_renderprocesshost_reuse_race.patch b/patches/chromium/fix_recover_from_renderprocesshost_reuse_race.patch
new file mode 100644
index 000000000..a5d4e2860
--- /dev/null
+++ b/patches/chromium/fix_recover_from_renderprocesshost_reuse_race.patch
@@ -0,0 +1,54 @@
+From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
+From: Dennis Cheng <dennis.cheng@discordapp.com>
+Date: Wed, 1 Jul 2026 21:56:22 +0000
+Subject: fix: recover from RenderProcessHost reuse race instead of
+ CHECK-crashing the browser process
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+Avoid CHECK-crashing the browser process when a renderer process host is
+re-initialized from inside a render-process-gone handler (e.g.
+webContents.reload() called synchronously on renderer crash, as the Discord
+client does).
+
+Chromium 148 (crrev.com/c/7031539) added a launch-time CHECK in
+RendererStartupHelper::OnRenderProcessLaunched asserting the process was
+registered at OnRenderProcessHostCreated. A synchronous reload re-enters
+RenderProcessHost::Init() mid-ProcessDied observer iteration: the re-fired
+OnRenderProcessHostCreated no-ops because the dead process's map entry is still
+present, UntrackProcess then erases it, and the CHECK aborts when the new
+process finishes launching.
+
+Upstream already fixed this exact reuse race on Android (crrev.com/c/7330559)
+by re-registering the process — restoring the mojom::Renderer remote and
+observer without re-running full InitializeProcess (which could re-send
+loaded-extension state). This patch extends that recovery to all platforms. The
+skipped re-initialization only matters for renderers hosting extension content,
+which doesn't apply to Discord's windows.
+
+diff --git a/extensions/browser/renderer_startup_helper.cc b/extensions/browser/renderer_startup_helper.cc
+index cacaf4fe5faf634e263546bef9111b8841ec1297..0df1221d8a8d24ccc248c8f465c0a0e25e0ef98a 100644
+--- a/extensions/browser/renderer_startup_helper.cc
++++ b/extensions/browser/renderer_startup_helper.cc
+@@ -266,8 +266,7 @@ void RendererStartupHelper::OnRenderProcessLaunched(
+     // extensions should have already been initialized in
+     // OnRenderProcessHostCreated(), if it corresponds to the same context.
+     ExtensionsBrowserClient* client = ExtensionsBrowserClient::Get();
+-#if BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_CHROMEOS)
+-    // On Android and ChromeOS, handle race condition during process restart:
++    // Handle race condition during process restart:
+     // 1. OnRenderProcessHostCreated() initializes extensions and populates
+     // process_mojo_map_.
+     // 2. Process startup fails in some cases.
+@@ -280,10 +279,6 @@ void RendererStartupHelper::OnRenderProcessLaunched(
+         client->IsSameContext(browser_context_, host->GetBrowserContext())) {
+       RegisterProcess(host);
+     }
+-#else
+-    CHECK(GetRenderer(host) != nullptr ||
+-          !client->IsSameContext(browser_context_, host->GetBrowserContext()));
+-#endif  // BUILDFLAG(IS_ANDROID) || BUILDFLAG(IS_CHROMEOS)
+     return;
+   }
+   // Otherwise, we should *not* have initialized the host yet.
