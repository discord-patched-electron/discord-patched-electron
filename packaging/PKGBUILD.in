# Generated from pinned runtime and open-source bootstrap inputs.
pkgname=@PACKAGE@
pkgver=@VERSION@
pkgrel=@REVISION@
pkgdesc='Discord @DISCORD@ with patched Electron @ELECTRON@ (requires x86-64-v3 CPU)'
arch=('x86_64')
url='https://github.com/discord-patched-electron/discord-patched-electron'
license=('MIT' 'BSD-3-Clause' 'AGPL-3.0-only')
options=('!strip')
provides=('@DESKTOP_ID@')
conflicts=(@CONFLICTS@)
depends=('alsa-lib' 'gtk3' 'libcups' 'libxss' 'libxtst' 'nss' 'libdrm' 'mesa' 'libpulse' 'python' 'python-capstone' 'python-pyelftools' 'brotli' 'ca-certificates' 'gnupg' 'pipewire' 'pipewire-audio' 'zenity')
makedepends=('asar' 'unzip')
optdepends=('xdg-utils: open links and files'
            'kdotool: KDE Plasma window labels in the audio picker'
            'wireplumber: audio routing when no PipeWire session manager is running'
            'xorg-xprop: selected-window identity for experimental application audio')
source=(
@SOURCES@
)
sha256sums=(
@CHECKSUMS@
)
noextract=(
@ARCHIVES@
)

prepare() {
  tar -xf support.tar
  python support/scripts/stage_package.py --inputs package-inputs.json --asar /usr/bin/asar
}

package() {
  local root="$pkgdir/usr/lib/$pkgname"
  install -d "$root"
  cp -a stage/. "$root/"
  chmod 4755 "$root/runtime/chrome-sandbox"
  install -Dm755 discord-launcher.sh "$root/launch.sh"
  install -d "$pkgdir/usr/bin"
  ln -s "/usr/lib/$pkgname/launch.sh" "$pkgdir/usr/bin/$pkgname"
  ln -s "$pkgname" "$pkgdir/usr/bin/@DESKTOP_ID@"
  install -Dm644 discord.desktop "$pkgdir/usr/share/applications/@DESKTOP_ID@.desktop"
  install -Dm644 stage/discord.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/@DESKTOP_ID@.png"
  install -Dm644 support/THIRD_PARTY.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY.md"
  install -Dm644 support/LICENSE "$pkgdir/usr/share/licenses/$pkgname/PROJECT-LICENSE"
  install -Dm644 stage/bootstrap/LICENSE "$pkgdir/usr/share/licenses/$pkgname/OPENASAR-LICENSE"
  install -Dm644 package-inputs.json "$root/package-inputs.json"
  install -Dm755 libdpe-camera-probe.so "$root/libdpe-camera-probe.so"
}
