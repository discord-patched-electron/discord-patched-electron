# Project-owned toolchain: keep Chromium's pinned Clang, sysroot and tool rules.
# No edit to an upstream file is required. Host tools keep their normal toolchain.
# Generated from the pinned upstream template with baseline flags before each
# target's flags. This preserves CPU-dispatched AVX-512/SIMD implementations.
import("//dpe_build/gcc_toolchain.gni")

dpe_clang_toolchain("clang_x64_v3") {
  enable_linker_map = true
  extra_cppflags = "@CPU_FLAGS@"
  extra_asmflags = "@CPU_FLAGS@"
  extra_ldflags = "@CPU_FLAGS@"
  toolchain_args = {
    current_cpu = "x64"
    current_os = "linux"
  }
}
