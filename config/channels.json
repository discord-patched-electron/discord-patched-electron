{
  "architecture": "x86_64",
  "compiler": {
    "enabled": true,
    "minimum_disk_gb": 100,
    "minimum_memory_gb": 8,
    "paid_usage_allowed": false,
    "provider": "blacksmith",
    "runner": "blacksmith-16vcpu-ubuntu-2404"
  },
  "discord_channels": [
    "canary"
  ],
  "electron_channels": [
    "prerelease"
  ],
  "package_pattern": "discord-{discord}-{electron}-patched-electron-bin",
  "poll_cron": "22 * * * *",
  "schema": 1,
  "security_poll_cron": "2,7,12,17,27,32,37,42,47,52,57 * * * *"
}
