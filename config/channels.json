{
  "schema": 1,
  "architecture": "x86_64",
  "electron_channels": ["prerelease"],
  "discord_channels": ["stable", "ptb", "canary"],
  "package_pattern": "discord-{discord}-{electron}-patched-electron-bin",
  "poll_cron": "17 * * * *",
  "compiler": {
    "enabled": false,
    "provider": "self-hosted",
    "runner": "discord-electron-compiler",
    "minimum_disk_gb": 100,
    "minimum_memory_gb": 8,
    "paid_usage_allowed": false
  }
}
