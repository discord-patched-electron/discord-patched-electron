{
  "architecture": "x86_64",
  "compiler": {
    "enabled": true,
    "minimum_disk_gb": 100,
    "minimum_memory_gb": 8,
    "paid_usage_allowed": false,
    "provider": "self-hosted",
    "runner": "discord-electron-compiler"
  },
  "discord_channels": [
    "stable",
    "ptb",
    "canary"
  ],
  "electron_channels": [
    "prerelease"
  ],
  "package_pattern": "discord-{discord}-{electron}-patched-electron-bin",
  "poll_cron": "7,22,37,52 * * * *",
  "schema": 1
}
